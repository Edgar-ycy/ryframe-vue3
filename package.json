{
  "name": "ryframe-vue3",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.4",
      "immutable": "5.1.9",
      "js-yaml": "4.3.0"
    }
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint . --max-warnings=0",
    "lint:styles": "stylelint \"src/**/*.{css,scss,vue}\" --max-warnings=0",
    "check:sources": "node scripts/check-source-hygiene.mjs",
    "check:dependencies": "node --test scripts/prerelease-dependency-policy.test.mjs && node scripts/check-prerelease-dependencies.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:contract": "node scripts/check-api-contract.mjs",
    "api:generate": "openapi-typescript openapi/openapi.json -o src/api/generated/schema.ts",
    "api:sync": "node scripts/sync-api-contract.mjs && pnpm api:generate",
    "api:check": "pnpm check:contract && pnpm api:generate && git diff --exit-code -- openapi/openapi.json src/api/generated/schema.ts src/shared/security/passwordPolicy.generated.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "vue-tsc --noEmit",
    "build": "vite build",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check": "pnpm check:sources && pnpm check:dependencies && pnpm check:architecture && pnpm api:check && pnpm lint && pnpm lint:styles && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm check:bundle && pnpm test:e2e",
    "preview": "vite preview"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.18.1",
    "element-plus": "^2.14.2",
    "pinia": "^3.0.4",
    "vue": "^3.5.38",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@types/node": "^25.9.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^16.5.0",
    "openapi-typescript": "^7.13.0",
    "sass": "^1.101.3",
    "stylelint": "^17.14.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-element-plus": "^0.11.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.4",
    "yaml": "^2.9.0"
  }
}
