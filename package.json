{
  "name": "ryframe-vue3",
  "private": true,
  "version": "0.11.2",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint . --max-warnings=0 --cache --cache-location .local-tests/eslint/cache",
    "lint:fix": "eslint . --fix --max-warnings=0 --cache --cache-location .local-tests/eslint/cache",
    "lint:styles": "stylelint \"src/**/*.{css,scss,vue}\" --max-warnings=0 --cache --cache-location .local-tests/stylelint/cache",
    "lint:styles:fix": "stylelint \"src/**/*.{css,scss,vue}\" --fix --max-warnings=0 --cache --cache-location .local-tests/stylelint/cache",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:workflows": "node scripts/check-workflows.mjs",
    "check:dependencies": "node scripts/check-prerelease-dependencies.mjs",
    "check:supply-chain-policy": "node scripts/check-supply-chain-policy.mjs",
    "check:source-size": "node scripts/check-source-size.mjs",
    "check:imports": "node scripts/check-import-boundaries.mjs",
    "check:api-source": "node scripts/verify-local-api-contract.mjs",
    "check:contract": "node scripts/check-api-contract.mjs",
    "check:api-operations": "node scripts/check-api-operation-usage.mjs",
    "check:api-artifacts": "node scripts/generate-api-artifacts.mjs --check",
    "api:generate": "node scripts/generate-api-artifacts.mjs --write",
    "api:sync": "node scripts/sync-api-contract.mjs && node scripts/generate-api-artifacts.mjs --write",
    "api:check": "pnpm check:api-source && pnpm check:contract && node scripts/generate-api-artifacts.mjs --check && pnpm check:api-operations",
    "api:check:upstream": "pnpm api:check && node scripts/sync-api-contract.mjs --verify-upstream",
    "consumer:check": "node scripts/check-consumer-contract.mjs",
    "typecheck:app": "vue-tsc -p tsconfig.app.json --noEmit",
    "typecheck:test": "vue-tsc -p tsconfig.test.json --noEmit",
    "typecheck": "pnpm typecheck:app && pnpm typecheck:test",
    "test": "pnpm test:unit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:targeted-coverage": "vitest run --config vitest.targeted.config.ts --coverage",
    "test:browser-smoke": "playwright test --config playwright.config.ts",
    "test:browser-real": "playwright test --config playwright.real.config.ts",
    "test:policies": "node --test scripts/tests/*.test.mjs",
    "sbom:generate": "node scripts/generate-sbom.mjs",
    "build": "vite build",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:fast": "node scripts/run-fast-checks.mjs",
    "ci:static": "pnpm format:check && pnpm check:workflows && pnpm check:dependencies && pnpm test:policies && pnpm check:source-size && pnpm check:imports && pnpm api:check:upstream && pnpm lint && pnpm lint:styles && pnpm typecheck",
    "ci:unit": "pnpm test:unit && pnpm test:targeted-coverage",
    "ci:build": "pnpm build && pnpm check:bundle",
    "ci:browser": "pnpm test:browser-smoke",
    "ci:browser-real": "pnpm test:browser-real",
    "check": "pnpm format:check && pnpm check:workflows && pnpm check:dependencies && pnpm test:policies && pnpm check:source-size && pnpm check:imports && pnpm api:check && pnpm lint && pnpm lint:styles && pnpm typecheck && pnpm ci:unit && pnpm build && pnpm check:bundle",
    "preview": "vite preview"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@tanstack/vue-query": "^5.101.4",
    "axios": "^1.18.1",
    "dompurify": "^3.4.13",
    "echarts": "6.1.0",
    "element-plus": "^2.14.3",
    "markdown-it": "^14.3.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.40",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.62.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "4.1.11",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-sfc": "^3.5.40",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^16.5.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "sass": "^1.101.7",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-element-plus": "^0.11.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8",
    "yaml": "^2.9.0"
  }
}
