{
  "name": "ryframe-vue3",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint . --max-warnings=0",
    "lint:styles": "stylelint \"src/**/*.{css,scss,vue}\" --max-warnings=0",
    "check:workflows": "node scripts/check-workflows.mjs",
    "check:dependencies": "node scripts/check-prerelease-dependencies.mjs",
    "check:source-size": "node scripts/check-source-size.mjs",
    "check:contract": "node scripts/check-api-contract.mjs",
    "api:generate": "node scripts/generate-api-artifacts.mjs --write",
    "api:sync": "node scripts/sync-api-contract.mjs && node scripts/generate-api-artifacts.mjs --write",
    "api:check": "node scripts/sync-api-contract.mjs --verify-local && pnpm check:contract && node scripts/generate-api-artifacts.mjs --check",
    "api:check:upstream": "pnpm api:check && node scripts/sync-api-contract.mjs --verify-upstream",
    "typecheck": "vue-tsc --noEmit",
    "build": "vite build",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check": "pnpm check:workflows && pnpm check:dependencies && pnpm check:source-size && pnpm api:check && pnpm lint && pnpm lint:styles && pnpm typecheck && pnpm build && pnpm check:bundle",
    "preview": "vite preview"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@tanstack/vue-query": "^5.101.4",
    "axios": "^1.18.1",
    "dompurify": "^3.4.12",
    "echarts": "6.1.0",
    "element-plus": "^2.14.3",
    "markdown-it": "^14.3.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.40",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.9.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^16.5.0",
    "openapi-typescript": "^7.13.0",
    "sass": "^1.101.7",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-element-plus": "^0.11.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.1.5",
    "vue-tsc": "^3.3.8",
    "yaml": "^2.9.0"
  }
}
