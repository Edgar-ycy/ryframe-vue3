{
  "name": "ryframe-vue3",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint . --max-warnings=0",
    "lint:styles": "stylelint \"src/**/*.{css,scss,vue}\" --max-warnings=0",
    "check:sources": "node scripts/check-source-hygiene.mjs",
    "check:workflows": "node scripts/check-workflows.mjs",
    "check:dependencies": "node --test scripts/prerelease-dependency-policy.test.mjs && node scripts/check-prerelease-dependencies.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:contract": "node scripts/check-api-contract.mjs",
    "api:generate": "openapi-typescript openapi/openapi.json -o src/api/generated/schema.ts && node scripts/localize-generated-header.mjs src/api/generated/schema.ts",
    "api:sync": "node scripts/sync-api-contract.mjs && pnpm api:generate",
    "api:check": "node scripts/sync-api-contract.mjs --verify-local && pnpm check:contract && pnpm api:generate && git diff --exit-code -- openapi/openapi.json openapi/source.json src/api/generated/schema.ts src/shared/security/passwordPolicy.generated.json",
    "api:check:upstream": "pnpm api:check && node scripts/sync-api-contract.mjs --verify-upstream",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "vue-tsc --noEmit",
    "build": "vite build",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check": "pnpm check:sources && pnpm check:workflows && pnpm check:dependencies && pnpm check:architecture && pnpm api:check && pnpm lint && pnpm lint:styles && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm check:bundle && pnpm test:e2e",
    "preview": "vite preview"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@tanstack/vue-query": "^5.101.4",
    "axios": "^1.18.1",
    "dompurify": "^3.4.12",
    "element-plus": "^2.14.3",
    "markdown-it": "^14.3.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.40",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.9.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "openapi-typescript": "^7.13.0",
    "sass": "^1.101.7",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-element-plus": "^0.11.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8",
    "yaml": "^2.9.0"
  }
}
